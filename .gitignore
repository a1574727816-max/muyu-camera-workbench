# Public release allowlist. Private research, firmware and runtime files stay local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/server/
!/tools/
!/docs/
!/embedded/
!/.github/

/server/*
!/server/*.py
!/server/*.md
!/server/requirements*.txt
!/server/cam-manager.service
!/server/config.example.json
!/server/environment.example
/tools/*
!/tools/test_camera_selector.cjs
!/tools/test_netguard_host.py

__pycache__/
.pytest_cache/
*.py[cod]
.venv/
venv/
.env
auth.key
auth.json
auth.sqlite3*
config.json
*.backup
*.pem
*.key
*.bin
*.squashfs
*.mkv
*.mp4
*.jpg
*.png
*.wav
*.log
*.core
core.*
build/
data/
